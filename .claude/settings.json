{
  "permissions": {
    "allow": [
      "Read(./**)"
    ],
    "deny": [
      "Read(../**)",
      "Edit(../**)",
      "Write(../**)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "ask": [
      "Edit(./**)",
      "Write(./**)",
      "NotebookEdit(./**)",
      "WebFetch",
      "WebSearch",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ],
    "defaultMode": "default"
  },
  "enabledPlugins": {
    "security-guidance@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true,
    "pr-review-toolkit@claude-code-plugins": true
  }
}
